# Copy to .env.local and fill in. Never commit real values.

DATABASE_URL=postgresql://basket_portal:change-me@127.0.0.1:5434/basket_portal
AUTH_DATABASE_URL=postgresql://basket_auth:change-me@127.0.0.1:5433/basket_auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_TIMEZONE=America/Bogota
NEXT_PUBLIC_APP_URL=http://localhost:3000

# basket-telemetry server reporter (docs/telemetry.md). Without the token
# nothing is sent; leave it empty outside the VPS.
TELEMETRY_INGEST_URL=http://127.0.0.1:3011/ingest/server
TELEMETRY_TOKEN=
